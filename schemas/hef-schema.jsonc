{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "HDL Exchange Format", // FIXME: bad title

  "definitions": {
    "sharedRecipeStep": {
      "type": "object",
      "properties": {
        "toolOptions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "library": {
          "type": "string"
        }
      }
    },

    "verilogLanguage": {
      "type": "string",
      "enum": ["verilog-1995", "verilog-2001", "verilog-2005"]
    },
    "systemVerilogLanguage": {
      "type": "string",
      "enum": ["systemverilog-2012", "systemverilog-2017", "systemverilog-2023"]
    },
    "verilogRecipeStep": {
      "allOf": [
        { "$ref": "#/definitions/sharedRecipeStep" },
        {
          "oneOf": [
            {
              "type": "object",
              "required": ["compile", "verilogVersion"],
              "properties": {
                "compile": { "const": "verilog" },
                "verilogVersion": { "$ref": "#/definitions/verilogLanguage" }
              }
            },
            {
              "type": "object",
              "required": ["compile", "systemVerilogVersion"],
              "properties": {
                "compile": { "const": "systemverilog" },
                "systemVerilogVersion": {
                  "$ref": "#/definitions/systemVerilogLanguage"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "compile",
                "systemVerilogSuffix",
                "verilogVersion",
                "systemVerilogVersion"
              ],
              "properties": {
                "compile": { "const": "verilog/systemverilog" },
                "verilogVersion": { "$ref": "#/definitions/verilogLanguage" },
                "systemVerilogVersion": {
                  "$ref": "#/definitions/systemVerilogLanguage"
                },
                "systemVerilogSuffix": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": ["compile", "library", "files"],

          "properties": {
            "library": { "type": "string" },

            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["libraryFile"],
                    "properties": {
                      "libraryFile": { "type": "string" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["moduleSearchPath"],
                    "properties": {
                      "moduleSearchPath": { "type": "string" }
                    }
                  }
                ]
              }
            },

            "visibleLibraries": {
              "type": "array",
              "items": { "type": "string" }
            },

            "includeDirectories": {
              "type": "array",
              "items": { "type": "string" }
            },

            "directives": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },

            "moduleSearchFileSuffixes": {
              "type": "array",
              "items": { "type": "string" }
            },

            // Not sure about this one, we could remove it
            // single file compilation unit scope could be expressed as multiple verilog recipe steps
            // it would require a bit more downstream processing to re-create an efficient tool invocation if we drop this
            "multiFileCompilationUnitScope": {
              "type": "boolean",
              "default": true
            }
          }
        }
      ]
    },

    "vhdlLanguage": {
      "type": "string",
      "enum": ["vhdl-1987", "vhdl-1993", "vhdl-2002", "vhdl-2008", "vhdl-2019"]
    },
    "vhdlRecipeStep": {
      "allOf": [
        { "$ref": "#/definitions/sharedRecipeStep" },
        {
          "type": "object",
          "required": ["compile", "library", "files"],
          "properties": {
            "compile": { "const": "vhdl" },
            "library": { "type": "string" },
            "version": { "$ref": "#/definitions/vhdlLanguage" },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },

            "conditionalAnalysis": {
              // only relevant for VHDL 2019
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    }
  },

  "type": "object",
  "additionalProperties": false,

  "required": ["compilationSteps"],
  "properties": {
    "directory": {
      "description": "the base directory, all other paths are relative to this directory",
      "type": "string",
      // the default is the location of this file
      "default": "."
    },
    "compilationSteps": {
      "description": "one recepee corresponds roughly to one tool invocation multiple recepe steps can compile to the same library",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/verilogRecipeStep" },
          { "$ref": "#/definitions/vhdlRecipeStep" }
        ]
      }
    }
  }
}
